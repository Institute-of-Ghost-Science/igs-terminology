{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ioghostscience/terminology/schema/terms.schema.json",
  "title": "IGS Terminology Terms",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["term", "slug", "definition", "tags"],
    "properties": {
      "term": {
        "type": "string",
        "minLength": 1
      },
      "slug": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "definition": {
        "type": "string",
        "minLength": 1
      },
      "tags": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      },
      "aliases": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      },
      "related": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      },
      "references": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label"],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      },
      "history": {
        "type": "object",
        "additionalProperties": false,
        "required": ["added"],
        "properties": {
          "added": {
            "type": "string",
            "format": "date"
          },
          "updated": {
            "type": "string",
            "format": "date"
          }
        }
      }
    }
  },
  "uniqueItems": true
}
